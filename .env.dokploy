# COLISAP on Dokploy
#
# 1. Create a MySQL service in the same Dokploy project (database name: colisap).
# 2. Create an Application from this repository. Build Type: Dockerfile (file: Dockerfile).
# 3. Paste this file into Application > Environment and replace every "change-me".
#    Dokploy does not expand ${OTHER_VARIABLE} references, so always type the real value.
# 4. Domains: add the domain, Container Port 8080, HTTPS on (Let's Encrypt).
# 5. Advanced > Volumes: add a Volume Mount (not a Bind Mount) at
#      /var/www/html/storage/app
#    Without it, uploaded masterlist workbooks waiting for approval and members' withdrawal
#    letters are lost on every redeploy.
# 6. Deploy. Database tables, branches, policy settings, roles and permissions are created
#    automatically on every start.
# 7. First deploy only: open the container terminal and run
#      php artisan db:seed --force
#    It creates admin@bmpc.coop (Administrator) and crs@bmpc.coop (CRS Officer) and prints a
#    random password for each ONCE. Sign in as the Administrator, create the real user
#    accounts, then change or deactivate the two starter accounts.

APP_NAME="COLISAP Monitoring System"
APP_ENV=production
# Generate on your PC with: php artisan key:generate --show
# Never change it after going live (signed-in sessions and encrypted data depend on it).
APP_KEY=change-me
APP_DEBUG=false
# The exact address staff will open, with https and no trailing slash
APP_URL=https://colisap.barbazampc.cloud
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Send logs to the container output so they appear in Dokploy's Logs tab
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Use the "Internal Host", user and password shown on the Dokploy MySQL service page
DB_CONNECTION=mysql
DB_HOST=<mysql-internal-host>   
DB_PORT=3306
DB_DATABASE=colisap
DB_USERNAME=host
DB_PASSWORD=1234

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# The system does not send e-mail, so messages are only written to the log.
# If e-mail is added later: MAIL_MAILER=smtp plus MAIL_HOST, MAIL_PORT (587, or 465 with
# MAIL_SCHEME=smtps), MAIL_USERNAME and MAIL_PASSWORD.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@change-me.example.com"
MAIL_FROM_NAME="COLISAP Monitoring System"

# eTxtMo SMS gateway (Monitoring > Send SMS). Paste the full API key from the eTxtMo dashboard.
# Leave the key empty to keep SMS switched off.
ETXTMO_URL=https://etxtmo.barbazampc.cloud/api/v1
ETXTMO_API_KEY=

# Container settings (PHP memory and time limits, OPcache, health check, automatic migrations)
# are already set in the Dockerfile. Add a line here only to override one, for example:
# PHP_MEMORY_LIMIT=1G
