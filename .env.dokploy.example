# Paste into Dokploy > Application > Environment.
# Replace every value marked "change-me" before deploying.
#
# REQUIRED: add a persistent volume in Dokploy > Advanced > Volumes mounted at
#   /var/www/html/storage/app
# otherwise uploaded claim documents are lost on every redeploy.
#
# First deploy only: open the container terminal and run
#   php artisan db:seed --force
# Branches, policy settings, roles and permissions are created by the migrations. The seeder
# creates superadmin@ / admin@ / crs@bmpc.coop accounts and prints a random password for each.
# Sign in as the Super Admin, create real user accounts, then change passwords under your profile.

APP_NAME="COLISAP Monitoring System"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=change-me
APP_DEBUG=false
APP_URL=https://change-me.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Send logs to the container output so they appear in Dokploy's Logs tab
LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Use the "Internal Host" shown on the Dokploy MySQL service page
DB_CONNECTION=mysql
DB_HOST=change-me
DB_PORT=3306
DB_DATABASE=colisap
DB_USERNAME=change-me
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# SMTP: port 587 uses STARTTLS (leave MAIL_SCHEME=null); port 465 needs MAIL_SCHEME=smtps
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=change-me
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
MAIL_FROM_ADDRESS="change-me@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# serversideup/php container settings
PHP_OPCACHE_ENABLE=1
AUTORUN_ENABLED=true
AUTORUN_LARAVEL_MIGRATION=true
AUTORUN_LARAVEL_STORAGE_LINK=true
SSL_MODE=off
